{
  "name": "elise-clone",
  "version": "0.1.0",
  "description": "AI-powered healthcare scheduling assistant with voice and chat interfaces",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "quickstart": "tsx scripts/quickstart.ts",
    "reset": "tsx scripts/quickstart.ts --reset",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "tunnel": "./scripts/ngrok.sh",
    "prisma": "tsx scripts/prisma.ts",
    "db:migrate": "tsx scripts/prisma.ts migrate dev",
    "db:generate": "tsx scripts/prisma.ts generate",
    "db:push": "tsx scripts/prisma.ts db push",
    "db:studio": "tsx scripts/prisma.ts studio",
    "db:seed": "tsx scripts/prisma.ts db seed",
    "db:reset": "tsx scripts/prisma.ts migrate reset",
    "db:up": "tsx scripts/docker.ts up -d",
    "db:down": "tsx scripts/docker.ts down",
    "docker": "tsx scripts/docker.ts",
    "vapi:setup": "tsx scripts/vapi-setup.ts",
    "vapi:list": "tsx scripts/vapi-list.ts",
    "vapi:assign": "tsx scripts/vapi-assign.ts",
    "vapi:delete": "tsx scripts/vapi-delete.ts",
    "vapi:logs": "tsx scripts/vapi-logs.ts",
    "setup:availability": "tsx scripts/setup-availability.ts",
    "openemr:register": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx scripts/openemr-register-client.ts",
    "openemr:setup": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx scripts/openemr-setup.ts",
    "test:openemr": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx scripts/test-openemr.ts",
    "test:openemr:adapter": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx scripts/test-openemr-adapter.ts",
    "test:openmrs": "tsx test/openmrs-integration.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "healthcare",
    "scheduling",
    "voice-ai",
    "vapi"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.2.3",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "pg": "^8.18.0",
    "uuid": "^13.0.0"
  }
}
