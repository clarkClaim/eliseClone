# Elise Clone - Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Profile: which office/MRS to use (mrs or emr)
# This loads config from config/profiles/${PROFILE}.env
PROFILE=mrs

# VAPI API key (from https://dashboard.vapi.ai)
VAPI_API_KEY=

# Your ngrok static domain (from https://dashboard.ngrok.com/cloud-edge/domains)
NGROK_DOMAIN=

# =============================================================================
# OPTIONAL
# =============================================================================

# Node environment (development, production)
# NODE_ENV=development

# Sync interval in milliseconds (default: 60000)
# SYNC_INTERVAL_MS=60000

# =============================================================================
# PROFILE-SPECIFIC (loaded from config/profiles/${PROFILE}.env)
# =============================================================================
# The following are set automatically based on PROFILE:
#   - PORT (server port)
#   - DB_PORT (PostgreSQL port)
#   - VAPI_ASSISTANT_ID (injected by pnpm run vapi:setup)
#   - OPENMRS_URL/OPENEMR_URL and credentials
#
# For remote deployments, you can override DATABASE_URL directly:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
