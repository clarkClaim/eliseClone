# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elise_clone?schema=public"

# Server
PORT=3000
NODE_ENV=development

# VAPI - Voice AI
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# OpenMRS - Medical Record System
OPENMRS_URL=https://demo.openmrs.org/openmrs
OPENMRS_USER=admin
OPENMRS_PASSWORD=Admin123

# Sync Configuration (optional)
SYNC_INTERVAL_MS=300000  # 5 minutes
