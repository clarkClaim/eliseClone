# Choose ONE of the configurations below by uncommenting the relevant block.
# After registering an OAuth client, update credentials accordingly.

# -----------------------------------------------------------------------------
# LOCAL OpenEMR (recommended for development)
# Requires: ../openemr-local/ Docker setup
# Setup: cd ../openemr-local && ./start.sh
# -----------------------------------------------------------------------------
OPENEMR_URL=https://localhost:9300
OPENEMR_CLIENT_ID=LLes3qnnccrJpeETygrvNuk2y98h37l7vmr8Iw0T1UY
OPENEMR_CLIENT_SECRET=CONYMCt1voBpUFd5A8tywRSGguqUlzA91G-dL46tC_-8oCJNjvepnEhIxlkvUHpmouGLLvsw1rVS_cYVM84alQ
OPENEMR_USER=admin
OPENEMR_PASSWORD=pass

# -----------------------------------------------------------------------------
# PUBLIC DEMO (demo.openemr.io)
# Warning: Resets daily at 8:00 AM UTC, API access unreliable
# To switch: comment out LOCAL block above, uncomment below
# -----------------------------------------------------------------------------
# OPENEMR_URL=https://demo.openemr.io/a/openemr
# OPENEMR_CLIENT_ID=YOUR_DEMO_CLIENT_ID
# OPENEMR_CLIENT_SECRET=YOUR_DEMO_CLIENT_SECRET
