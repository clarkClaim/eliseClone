# EMR Profile - Evergreen Health (OpenEMR)
# This file is safe to commit (no secrets)

# Server (different port to avoid conflicts)
PORT=3001

# VAPI Assistant for this office (create via: pnpm run vapi:setup config/assistants/evergreen-elise.json)
