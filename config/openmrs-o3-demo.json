  "defaults": {
    "$comment": "Single-location defaults - used until multi-location config is implemented",
    "identifierTypeUuid": "05a29f94-c0ed-11e2-94be-8c13b969e334",
    "identifierLocationUuid": "44c3efb0-2583-4c80-a79e-1f756a03c0a1",
    "phoneAttributeUuid": "14d4f066-15f5-102d-96e4-000c29c2a5d7"
