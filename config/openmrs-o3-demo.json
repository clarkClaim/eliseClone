    "communityOutreach": {
      "uuid": "1ce1b7d4-c865-4178-82b0-5932e51503d6",
      "name": "Community Outreach",
      "tags": ["Visit Location", "Login Location"],
      "useCase": "Mobile/community health programs"
    },
    "inpatientWard": {
      "uuid": "ba685651-ed3b-4e63-9b35-78893060758a",
